{
    "claudePath": "claude",
    "maxIterations": 10,
    "iterationTimeout": 600,
    "focusAreas": [
        {"id": "quality", "name": "Match Quality", "description": "Improve matching accuracy and confidence scores"},
        {"id": "speed", "name": "Performance", "description": "Optimize pipeline speed and caching"},
        {"id": "testing", "name": "Test Coverage", "description": "Add tests and improve test reliability"},
        {"id": "agents", "name": "Self-Healing", "description": "Enhance self-healing agents and error recovery"},
        {"id": "otio", "name": "Timeline Output", "description": "Improve OTIO/EDL/XML generation"},
        {"id": "client-learning", "name": "Client Learning", "description": "Cross-project learning and client presets"},
        {"id": "pipeline", "name": "Pipeline Core", "description": "Core pipeline stages and orchestration"},
        {"id": "rate-limiting", "name": "Rate Limiting", "description": "YouTube download resilience and fallbacks"},
        {"id": "caption", "name": "Caption Mode", "description": "Caption-first mode and transcript handling"},
        {"id": "config", "name": "Configuration", "description": "Config management and validation"},
        {"id": "compilation", "name": "Compilation Mode", "description": "Keyword compilation and montage features"}
    ],
    "autonomy": {
        "maxIterations": 10,
        "iterationTimeout": 600,
        "fastFail": {
            "consecutiveFailures": 3,
            "minIterationTime": 120
        },
        "autoRetry": {
            "enabled": true,
            "maxRetries": 2,
            "backoffSeconds": 30
        }
    },
    "pipelineStages": {
        "order": [
            "ANALYZE", "ENTITY_IMAGES", "ENTITY_VIDEOS", "VIDEO_METADATA",
            "CAPTION", "DOWNLOAD", "STOCK", "BROLL_DOWNLOAD", "REMIX",
            "TRANSCRIBE", "PREMISE", "SCENE_DETECTION", "MATCH",
            "BROLL_MATCH", "ITERATIVE_MATCH", "DOWNLOAD_SEGMENTS", "OUTPUT"
        ],
        "groups": {
            "download": ["CAPTION", "DOWNLOAD", "STOCK", "BROLL_DOWNLOAD", "DOWNLOAD_SEGMENTS"],
            "analysis": ["ANALYZE", "ENTITY_IMAGES", "ENTITY_VIDEOS", "VIDEO_METADATA", "PREMISE", "SCENE_DETECTION"],
            "matching": ["MATCH", "BROLL_MATCH", "ITERATIVE_MATCH"],
            "output": ["OUTPUT"]
        }
    },
    "testProject": {
        "path": "E:/Edit Job/_ralph_test",
        "maxDuration": 30,
        "maxVideos": 3
    },
    "testPatterns": {
        "quality": ["test_match*.py", "test_scoring*.py"],
        "speed": ["test_cache*.py", "test_parallel*.py", "test_embedding*.py"],
        "testing": ["test_sprint*.py"],
        "agents": ["test_agent*.py", "test_healer*.py"],
        "otio": ["test_otio*.py", "test_timeline*.py"],
        "pipeline": ["test_pipeline*.py", "test_stage*.py"],
        "rate-limiting": ["test_download*.py"],
        "caption": ["test_caption*.py", "test_transcri*.py"],
        "config": ["test_config*.py"]
    },
    "relevantFiles": {
        "quality": ["src/matching.py", "src/matching/", "src/embeddings.py"],
        "speed": ["src/cache/", "src/transcription/parallel_processor.py", "src/embeddings.py"],
        "testing": ["tests/"],
        "agents": ["src/agents/"],
        "otio": ["src/otio/", "src/otio_builder.py"],
        "client-learning": ["src/client_profile.py", "scripts/ralph/clients.json"],
        "pipeline": ["src/pipeline.py", "src/stages/"],
        "rate-limiting": ["src/downloader/", "src/downloader/core.py"],
        "caption": ["src/caption_fetcher.py", "src/transcription/"],
        "config": ["src/config.py", "src/config/", "config.yaml"]
    }
}
