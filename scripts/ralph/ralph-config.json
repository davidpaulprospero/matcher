    "categoryOrder": ["core", "acquisition", "processing", "output", "intelligence", "meta"],
    "autonomy": {
        "maxIterations": 115,
        "iterationTimeout": 600,
        "fastFail": {
            "consecutiveFailures": 3,
            "minIterationTime": 120
        },
        "autoRetry": {
            "enabled": true,
            "maxRetries": 2,
            "backoffSeconds": 30
        }
    },
    "pipelineStages": {
        "order": [
            "ANALYZE", "ENTITY_IMAGES", "ENTITY_VIDEOS", "VIDEO_METADATA",
            "CAPTION", "DOWNLOAD", "STOCK", "BROLL_DOWNLOAD", "REMIX",
            "TRANSCRIBE", "PREMISE", "SCENE_DETECTION", "MATCH",
            "BROLL_MATCH", "ITERATIVE_MATCH", "DOWNLOAD_SEGMENTS", "OUTPUT"
        ],
        "groups": {
            "download": ["CAPTION", "DOWNLOAD", "STOCK", "BROLL_DOWNLOAD", "DOWNLOAD_SEGMENTS"],
            "analysis": ["ANALYZE", "ENTITY_IMAGES", "ENTITY_VIDEOS", "VIDEO_METADATA", "PREMISE", "SCENE_DETECTION"],
            "matching": ["MATCH", "BROLL_MATCH", "ITERATIVE_MATCH"],
            "output": ["OUTPUT"]
        }
    },
    "testProject": {
        "path": "E:/Edit Job/_ralph_test",
        "maxDuration": 30,
        "maxVideos": 3
    },
    "testPatterns": {
        "quality": ["test_match*.py", "test_scoring*.py"],
        "speed": ["test_cache*.py", "test_parallel*.py", "test_embedding*.py"],
        "testing": ["test_sprint*.py"],
        "agents": ["test_agent*.py", "test_healer*.py"],
        "otio": ["test_otio*.py", "test_timeline*.py"],
        "pipeline": ["test_pipeline*.py", "test_stage*.py"],
        "rate-limiting": ["test_download*.py", "test_rate*.py"],
        "caption": ["test_caption*.py", "test_transcri*.py"],
        "config": ["test_config*.py"],
        "download": ["test_download*.py", "test_downloader*.py"],
        "unit-tests": ["test_*.py"],
        "integration-tests": ["tests/integration/*.py"],
        "mutation-tests": ["tests/*.py"],
        "documentation": ["tests/test_docs*.py"],
        "ux": ["tests/test_cli*.py", "tests/test_prompts*.py"],
        "compilation": ["test_keyword*.py", "test_compilation*.py"],
        "client-learning": ["test_client*.py", "test_profile*.py"]
    },
    "relevantFiles": {
        "quality": ["src/matching.py", "src/matching/", "src/embeddings.py"],
        "speed": ["src/cache/", "src/transcription/parallel_processor.py", "src/embeddings.py"],
        "testing": ["tests/conftest.py", "tests/fixtures/", "pyproject.toml", "requirements-dev.txt"],
        "agents": ["src/agents/"],
        "otio": ["src/otio/", "src/otio_builder.py"],
        "client-learning": ["src/client_profile.py", "scripts/ralph/clients.json"],
        "pipeline": ["src/pipeline.py", "src/stages/"],
        "rate-limiting": ["src/downloader/", "src/downloader/core.py", "src/downloader/rate_limit_budget.py", "src/downloader/cookie_rotator.py", "src/config/sections/download.py"],
        "caption": ["src/caption_fetcher.py", "src/transcription/"],
        "config": ["src/config.py", "src/config/", "config.yaml"],
        "download": ["src/downloader/", "src/downloader/core.py", "src/downloader/audio_first.py", "src/downloader/title_filter.py", "src/downloader/speech_screening.py", "src/downloader/utils.py", "src/caption_fetcher.py", "src/config/sections/download.py"],
        "unit-tests": ["tests/conftest.py", "tests/fixtures/", "pyproject.toml"],
        "integration-tests": ["tests/integration/"],
        "mutation-tests": ["tests/conftest.py", "pyproject.toml"],
        "documentation": ["CLAUDE.md", "README.md", "REFACTORING.md", "docs/"],
        "ux": ["src/cli/", "main.py"],
        "compilation": ["src/keyword_extractor.py", "src/stages/remix_stage.py"]
