{
  "mcpServers": {
    "remotion-documentation": {
      "command": "cmd",
      "args": ["/c", "npx", "@remotion/mcp@latest"]
    },
    "markitdown": {
      "command": "cmd",
      "args": ["/c", "uvx", "markitdown-mcp==0.0.1a4"]
    },
    "desktop-commander": {
      "command": "cmd",
      "args": ["/c", "npx", "@wonderwhy-er/desktop-commander@0.2.29"]
    },
    "context7": {
      "command": "cmd",
      "args": ["/c", "npx", "@upstash/context7-mcp@1.0.31"],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "github-mcp-server": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "-e", "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server:0.29.0"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}
