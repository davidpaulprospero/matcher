# Trello API Credentials for stu
# Copy this file and rename to your account name, e.g., accounts/john.env

TRELLO_API_KEY=your_api_key_here
TRELLO_TOKEN=your_token_here
TRELLO_BOARD_ID=your_board_id_here

# Optional: default brand channel used by pipeline queue, Discord prep,
# and as the fallback lipsync channel when a board routes projects elsewhere.
# Expected values: RRU or DSR
DEFAULT_CHANNEL=RRU

# Optional: DiscordChatExporter integration for pipeline_queue_state.py discord-prepare
# DISCORD_TOKEN should be your Discord user token for this account.
# DISCORD_CHANNEL_IDS should be comma-separated numeric channel IDs that receive
# "Script / Voiceover / Description -- Pipeline Complete" posts.
DISCORD_TOKEN=your_discord_token_here
DISCORD_CHANNEL_IDS=123456789012345678,234567890123456789

# Optional override if DiscordChatExporter is not on PATH.
# Examples:
# DISCORD_CHAT_EXPORTER=C:\Tools\DiscordChatExporter\DiscordChatExporter.Cli.exe
# DISCORD_CHAT_EXPORTER=dotnet tool run DiscordChatExporter.Cli
DISCORD_CHAT_EXPORTER=

# Optional: gws auth (preferred for Drive downloads in pipeline-queue/newproject/lipsync)
# Set one of:
# 1) Access token (recommended for per-account automation)
GOOGLE_WORKSPACE_CLI_TOKEN=
# 2) Credentials file path (if token is not used)
# GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE=C:\path\to\credentials.json
# Optional impersonation when using service-account credentials:
# GOOGLE_WORKSPACE_CLI_IMPERSONATED_USER=editor@your-domain.com
