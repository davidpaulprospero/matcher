# AI33 TTS — copy these lines into your repo-root .env (already gitignored).
# Required:
AI33_API_KEY=sk_your_key_here

# Optional (defaults shown):
# API base URL — must be v3; v1 paths return "voice_id must start with..."
# errors. The "default" voice_id below is also rejected by v3 (must be a real
# provider-prefixed id, see "Voice ID format" below).
AI33_API_URL=https://api.ai33.pro/v3
AI33_VOICE_ID=elevenlabs_Q2ELiWzbuj5F0eFHXK6S
AI33_SPEED=1.04
AI33_STABILITY=0.50
AI33_SIMILARITY=0.60
AI33_STYLE=0.75
AI33_SPEAKER_BOOST=true
AI33_WITH_TRANSCRIPT=false
AI33_POLL_INTERVAL=2

# Voice ID format (v3 requirement): must start with one of these prefixes,
# followed by the upstream provider's voice id (e.g. elevenlabs_<id>,
# minimax_<id>, clone_<id>, edge_<id>, kokoro_<id>, vbee_<id>, fishaudio_<id>).
# The /voices catalog endpoint does NOT list every valid id — a voice that
# isn't in the listing can still be submitted successfully.